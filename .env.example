# Exchanges supported by CCXT.
CAS_EXCHANGES=bybit,okx,kucoin

# Interexchange mode.
CAS_INTEREXCHANGE_ENABLED=true
CAS_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
CAS_MIN_NET_PROFIT_PCT=0.30

# Triangular mode: automatically enumerates routes like USDT -> BNB -> ETH -> USDT.
CAS_TRIANGULAR_ENABLED=true
CAS_TRIANGULAR_ANCHOR_ASSET=USDT
CAS_TRIANGULAR_ASSETS=BTC,ETH,BNB,SOL,XRP,ADA,DOGE
# Set CAS_TRIANGULAR_ASSETS=* to inspect all active spot assets. This can generate many API calls.
CAS_TRIANGULAR_MAX_CYCLES=200
CAS_TRIANGULAR_MIN_NET_PROFIT_PCT=0.20

# Quote amount used to validate order-book depth for each opportunity.
CAS_NOTIONAL_USDT=1000
CAS_DEPTH_LIMIT=50
CAS_POLL_INTERVAL_SECONDS=15
CAS_ALERT_COOLDOWN_SECONDS=120

# Default taker fee. 10 bps = 0.10% per trade.
CAS_TAKER_FEE_BPS=10
# Optional per-exchange overrides in bps.
CAS_EXCHANGE_TAKER_FEE_BPS=bybit:10,okx:10,kucoin:10

# Extra conservative haircut for slippage/operational costs.
CAS_FIXED_COST_BPS=5

# Optional Telegram alerts. Leave blank to run console-only.
CAS_TELEGRAM_BOT_TOKEN=
CAS_TELEGRAM_CHAT_ID=
