# Exchanges supported by CCXT.
CAS_EXCHANGES=bybit,okx,kucoin

# Interexchange mode.
CAS_INTEREXCHANGE_ENABLED=true
CAS_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
CAS_MIN_NET_PROFIT_PCT=0.30

# Triangular mode: routes entirely inside one exchange.
CAS_TRIANGULAR_ENABLED=true
CAS_TRIANGULAR_ANCHOR_ASSET=USDT
CAS_TRIANGULAR_ASSETS=BTC,ETH,BNB,SOL,XRP,ADA,DOGE
# Set CAS_TRIANGULAR_ASSETS=* to inspect all active spot assets.
CAS_TRIANGULAR_MAX_CYCLES=200
CAS_TRIANGULAR_MIN_NET_PROFIT_PCT=0.20

# Hybrid mode: CEX -> external exchanger -> CEX.
# This matches routes such as USDT -> BNB -> ETH -> USDT where BNB -> ETH
# is quoted by an external exchange service.
CAS_HYBRID_ENABLED=true
CAS_HYBRID_EXCHANGES=bybit
CAS_HYBRID_ANCHOR_ASSET=USDT
CAS_HYBRID_ROUTE_PAIRS=BNB:ETH
CAS_HYBRID_START_AMOUNT_USDT=1000
CAS_HYBRID_MIN_NET_PROFIT_PCT=0.20
# Reject external quotes that create implausible value vs the CEX spot reference.
CAS_HYBRID_MAX_EXTERNAL_PREMIUM_PCT=5
CAS_HYBRID_ALLOW_SUSPICIOUS=false
# When true, reject a hybrid route unless CCXT explicitly reports the external
# withdrawal network and return deposit network as available.
CAS_HYBRID_REQUIRE_NETWORK_STATUS=false

# Optional live Bybit P2P entry: RUB -> USDT before the hybrid route.
# Requires official Bybit P2P API access. Keys stay only in your local .env.
# CAS only reads online ads; it does NOT place P2P orders.
CAS_P2P_ENABLED=false
CAS_BYBIT_P2P_API_KEY=
CAS_BYBIT_P2P_API_SECRET=
CAS_BYBIT_P2P_TESTNET=false
CAS_P2P_FIAT_CURRENCY=RUB
CAS_P2P_TOKEN=USDT
CAS_P2P_FIAT_AMOUNT=70000
CAS_P2P_MIN_COMPLETION_RATE=90
CAS_P2P_MIN_RECENT_ORDERS=10
CAS_P2P_REQUIRE_VERIFIED_ADVERTISER=true
CAS_P2P_PAGE_SIZE=100

# External quote providers. Empty means hybrid mode has no live external source.
# Supported provider kinds: http and static_rate (static_rate is diagnostics/tests only).
CAS_EXTERNAL_QUOTE_PROVIDERS_JSON=[]
# Example JSON provider (replace URL/path with a real documented quote endpoint):
# CAS_EXTERNAL_QUOTE_PROVIDERS_JSON='[{"kind":"http","name":"example","url":"https://example.com/api/quote","method":"GET","params":{"from":"{from_asset}","to":"{to_asset}","amount":"{amount}"},"response_mode":"json","output_path":"data.outputAmount","input_network":"BEP20","output_network":"ERC20"}]'

# Quote amount used for the interexchange/triangular modes.
CAS_NOTIONAL_USDT=1000
CAS_DEPTH_LIMIT=50
CAS_POLL_INTERVAL_SECONDS=15
CAS_ALERT_COOLDOWN_SECONDS=120

# Default taker fee. 10 bps = 0.10% per CEX trade.
CAS_TAKER_FEE_BPS=10
# Optional per-exchange overrides in bps.
CAS_EXCHANGE_TAKER_FEE_BPS=bybit:10,okx:10,kucoin:10

# Extra conservative haircut for slippage/operational costs.
CAS_FIXED_COST_BPS=5

# Optional Telegram alerts. Leave blank to run console-only.
CAS_TELEGRAM_BOT_TOKEN=
CAS_TELEGRAM_CHAT_ID=
